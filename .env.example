# ==============================================================================
# KAGGADU ADVENTURES — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values. Never commit .env.local.
# ==============================================================================

# Public Site URL (used for canonical URLs, sitemap.xml, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE (Required for database, authentication, and media storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Accepts Supabase Publishable key (sb_publishable_...) OR legacy Anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY! Accepts Supabase Secret key (sb_secret_...) OR legacy Service Role key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# WHATSAPP CONFIGURATION
# ------------------------------------------------------------------------------
# Default WhatsApp Business number for click-to-chat (digits with country code, e.g., 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: Official WhatsApp Business Cloud API (server-side only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Optional — app remains fully functional without these)
# ------------------------------------------------------------------------------
# Option A: Resend API
RESEND_API_KEY=
# Option B: SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender & Admin notification recipient
EMAIL_FROM=Kaggadu Adventures <noreply@kaggaduadventures.com>
ADMIN_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# ANALYTICS & SEARCH CONSOLE (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
